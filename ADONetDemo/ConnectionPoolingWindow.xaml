<Window x:Class="ADONetDemo.ConnectionPoolingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Q3 – Connection Pooling Demo" Height="680" Width="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Q3 – Connection Pooling Demo"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Connections to open:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox  Grid.Column="1" x:Name="TxtConnCount" Text="10" Width="70" Height="26"
                      VerticalContentAlignment="Center" Padding="4,0"/>
            <TextBlock Grid.Column="2" Text="  Iterations:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox  Grid.Column="3" x:Name="TxtIterations" Text="3" Width="60" Height="26"
                      VerticalContentAlignment="Center" Padding="4,0"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnPooled"    Content="Run WITH Pooling (Pooling=true)"
                    Width="230" Height="32" Click="BtnPooled_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnNoPool"    Content="Run WITHOUT Pooling (Pooling=false)"
                    Width="250" Height="32" Click="BtnNoPool_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnClearPool" Content="Clear Pool &amp; Reset"
                    Width="160" Height="32" Click="BtnClearPool_Click"
                    Margin="0,0,10,0"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontStyle="Italic"/>
        </StackPanel>

        <!-- Tab: Log + Explanation -->
        <TabControl Grid.Row="3" Margin="0,0,0,8">
            <TabItem Header="Timing Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             BorderThickness="0" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="How Connection Pooling Works">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock TextWrapping="Wrap" Padding="12" FontSize="12" LineHeight="20">
                        <Run FontSize="14" FontWeight="Bold">Connection Pooling in ADO.NET</Run>
                        <LineBreak/>
                        <Run>Opening a new physical TCP connection to SQL Server is expensive (~50–200 ms).</Run>
                        <LineBreak/>
                        <Run>Connection pooling keeps a cache of open connections that can be reused.</Run>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="Bold">How It Works</Run>
                        <LineBreak/>
                        <Run>• When SqlConnection.Open() is called, ADO.NET checks the pool for an</Run>
                        <LineBreak/>
                        <Run>  idle connection with the same connection string.</Run>
                        <LineBreak/>
                        <Run>• If found, the pooled connection is returned immediately (very fast).</Run>
                        <LineBreak/>
                        <Run>• If not found and pool size &lt; Max Pool Size, a new physical connection</Run>
                        <LineBreak/>
                        <Run>  is created and added to the pool.</Run>
                        <LineBreak/>
                        <Run>• SqlConnection.Close() / Dispose() returns the connection to the pool</Run>
                        <LineBreak/>
                        <Run>  (does NOT close the underlying TCP socket).</Run>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="Bold">Connection String Parameters</Run>
                        <LineBreak/>
                        <Run>  Pooling=true          – Enable pooling (default)</Run>
                        <LineBreak/>
                        <Run>  Min Pool Size=2       – Pre-create 2 connections at startup</Run>
                        <LineBreak/>
                        <Run>  Max Pool Size=20      – Maximum connections in the pool</Run>
                        <LineBreak/>
                        <Run>  Connection Lifetime=0 – How long a connection lives in the pool (0 = forever)</Run>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="Bold">Advantages</Run>
                        <LineBreak/>
                        <Run>✓ Dramatically reduces connection overhead in high-traffic apps</Run>
                        <LineBreak/>
                        <Run>✓ Limits the number of concurrent physical connections to the server</Run>
                        <LineBreak/>
                        <Run>✓ Transparent to application code – no code changes needed</Run>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="Bold">Best Practices</Run>
                        <LineBreak/>
                        <Run>• Always use "using" blocks so connections are returned to pool promptly.</Run>
                        <LineBreak/>
                        <Run>• Use the same connection string for all requests (pooling is per-string).</Run>
                        <LineBreak/>
                        <Run>• Call SqlConnection.ClearPool() / ClearAllPools() to force reset.</Run>
                    </TextBlock>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Setup hint -->
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Padding="8,6">
            <TextBlock FontSize="11" TextWrapping="Wrap">
                <Run FontWeight="Bold">Observe:</Run>
                <Run>Run WITH pooling first – subsequent iterations are much faster because</Run>
                <Run>physical connections are reused. Run WITHOUT pooling to see the overhead of</Run>
                <Run>creating a new TCP connection each time.</Run>
            </TextBlock>
        </Border>
    </Grid>
</Window>
