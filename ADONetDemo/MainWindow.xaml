<Window x:Class="ADONetDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ADO.NET Demo – Assignment 04" Height="420" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ADO.NET Assignment 04" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Working with ADO.NET"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <GroupBox Header="Question 1 – SqlDataAdapter vs SqlDataReader" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="Compare both approaches: read product data using SqlDataReader for fast forward-only reads and SqlDataAdapter for disconnected DataSet access."
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Open" Click="OpenDataAdapterReader_Click"
                            Width="80" HorizontalAlignment="Right"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Question 2 – SqlCommandBuilder with DataGrid" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="Edit product records in a DataGrid and use SqlCommandBuilder to automatically generate INSERT / UPDATE / DELETE commands."
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Open" Click="OpenCommandBuilder_Click"
                            Width="80" HorizontalAlignment="Right"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Question 3 – Connection Pooling Demo" Padding="8">
                <StackPanel>
                    <TextBlock Text="Open multiple connections and observe how ADO.NET connection pooling reuses physical connections, measuring the time difference."
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Open" Click="OpenConnectionPooling_Click"
                            Width="80" HorizontalAlignment="Right"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0"
                   FontSize="11"
                   Text="Configure the SQL Server connection string in App.xaml.cs before running."/>
    </Grid>
</Window>
